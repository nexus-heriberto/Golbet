@model IEnumerable<Golbet.DTOs.TeamDto>

@{
    ViewData["Title"] = "Equipos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Equipos</h1>
            <p class="text-muted mb-0">
                Administración de equipos de fútbol
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Nuevo equipo
        </a>
    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No hay equipos registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Escudo</th>
                        <th>Equipo</th>
                        <th>Ciudad</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var team in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(team.CrestUrl))
                                {
                                    <img src="@team.CrestUrl"
                                         alt="Escudo de @team.Name"
                                         style="width:50px;height:50px;object-fit:contain;" />
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sin escudo
                                    </span>
                                }
                            </td>

                            <td>
                                <strong>@team.Name</strong>
                            </td>

                            <td>
                                @team.City
                            </td>

                            <td>
                                @if (team.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactivo
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <a asp-action="Edit"
                                   asp-route-id="@team.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Editar
                                </a>

                                @if (team.IsActive)
                                {
                                    <form asp-action="Deactivate"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@team.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('¿Está seguro de desactivar este equipo?');">
                                            Desactivar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

