@model Golbet.DTOs.TeamFormDto

@{
    ViewData["Title"] = "Nuevo equipo";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1>Nuevo equipo</h1>
        <p class="text-muted">
            Registre un nuevo equipo de fútbol.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <partial name="_TeamForm" model="Model" />

            </form>

        </div>
    </div>

</div>

