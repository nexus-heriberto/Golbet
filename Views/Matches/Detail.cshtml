@using Golbet.Enums
@using Golbet.Helpers
@model Golbet.DTOs.MatchDetailDto

@{
    ViewData["Title"] = "Detalle del Partido";

    var statusText = Model.Status switch
    {
        MatchStatus.Scheduled => "Programado",
        MatchStatus.InProgress => "En juego",
        MatchStatus.Finished => "Finalizado",
        _ => Model.Status.ToString()
    };
}

<div class="container py-4">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-action="Index">Cartelera</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                Detalle del Partido
            </li>
        </ol>
    </nav>

    <!-- Encabezado -->
    <div class="text-center mb-4">
        <h1 class="display-5">Detalle del Partido</h1>

        <p class="text-muted">
            @Model.Date.ToColombiaTime().ToString("dd/MM/yyyy HH:mm")
        </p>

        <span class="badge bg-primary">
            @statusText
        </span>
    </div>

    <!-- Partido -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="row align-items-center text-center">

                <!-- Local -->
                <div class="col-md-5">
                    <img src="@(Model.HomeTeamCrestUrl ?? "/images/crest-placeholder.png")"
                         alt="@Model.HomeTeamName"
                         class="img-fluid mb-3"
                         style="height:110px; width:110px; object-fit:contain;" />

                    <h3 class="fw-bold">
                        @Model.HomeTeamName
                    </h3>
                </div>

                <!-- Marcador -->
                <div class="col-md-2 my-3 my-md-0">

                    @if (Model.Status == MatchStatus.Finished)
                    {
                        <div class="display-6 fw-bold">
                            @Model.HomeGoals - @Model.AwayGoals
                        </div>
                    }
                    else
                    {
                        <div class="fs-3 fw-bold">
                            VS
                        </div>
                    }

                </div>

                <!-- Visitante -->
                <div class="col-md-5">
                    <img src="@(Model.AwayTeamCrestUrl ?? "/images/crest-placeholder.png")"
                         alt="@Model.AwayTeamName"
                         class="img-fluid mb-3"
                         style="height:110px; width:110px; object-fit:contain;" />

                    <h3 class="fw-bold">
                        @Model.AwayTeamName
                    </h3>
                </div>

            </div>

        </div>
    </div>

    <!-- Cuotas -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4 class="text-center mb-4">
                Cuotas
            </h4>

            <div class="row text-center">

                <div class="col-4">
                    <div class="text-muted">1</div>
                    <div class="fs-4 fw-bold">
                        @Model.HomeOdds.ToString("0.00")
                    </div>
                    <small class="text-muted">
                        @Model.HomeTeamName
                    </small>
                </div>

                <div class="col-4">
                    <div class="text-muted">X</div>
                    <div class="fs-4 fw-bold">
                        @Model.DrawOdds.ToString("0.00")
                    </div>
                    <small class="text-muted">
                        Empate
                    </small>
                </div>

                <div class="col-4">
                    <div class="text-muted">2</div>
                    <div class="fs-4 fw-bold">
                        @Model.AwayOdds.ToString("0.00")
                    </div>
                    <small class="text-muted">
                        @Model.AwayTeamName
                    </small>
                </div>

            </div>

        </div>
    </div>

    <!-- Apuestas -->
    <div class="card shadow-sm mb-4">
        <div class="card-body text-center">

            <h5 class="mb-2">
                Apuestas realizadas
            </h5>

            <div class="display-6 fw-bold">
                @Model.TotalBets
            </div>

            <p class="text-muted mb-0">
                apuestas registradas para este partido
            </p>

        </div>
    </div>

    <!-- Acción -->
    @if (Model.Status == MatchStatus.Scheduled)
    {
        <div class="text-center mb-4">
            <button type="button"
                    class="btn btn-success"
                    disabled>
                Apostar (Pendiente por codear)
            </button>
        </div>
    }

    <!-- Regresar -->
    <div class="text-center">
        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Volver a la cartelera
        </a>
    </div>

</div>