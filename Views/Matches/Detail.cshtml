```cshtml
@using Golbet.Enums
@using Golbet.Services.Helpers
@using Golbet.Data
@using Microsoft.AspNetCore.Identity
@model Golbet.DTOs.MatchDetailDto

@{
    ViewData["Title"] = "Detalle del Partido";

    var statusText = Model.Status switch
    {
        MatchStatus.Scheduled => "Programado",
        MatchStatus.InProgress => "En juego",
        MatchStatus.Finished => "Finalizado",
        _ => Model.Status.ToString()
    };
}

<div class="container py-4">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-action="Index">Cartelera</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                Detalle del Partido
            </li>
        </ol>
    </nav>

    <!-- Encabezado -->
    <div class="text-center mb-4">
        <h1 class="display-5">Detalle del Partido</h1>

        <p class="text-muted">
            @Model.Date.ToColombiaTime().ToString("dd/MM/yyyy HH:mm")
        </p>

        <span class="badge bg-primary">
            @statusText
        </span>
    </div>

    <!-- Partido -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="row align-items-center text-center">

                <!-- Local -->
                <div class="col-md-5">
                    <img src="@(Model.HomeTeamCrestUrl ?? "/images/crest-placeholder.png")"
                         alt="@Model.HomeTeamName"
                         class="img-fluid mb-3"
                         style="height:110px; width:110px; object-fit:contain;" />

                    <h3 class="fw-bold">
                        @Model.HomeTeamName
                    </h3>
                </div>

                <!-- Marcador -->
                <div class="col-md-2 my-3 my-md-0">

                    @if (Model.Status == MatchStatus.Finished)
                    {
                        <div class="display-6 fw-bold">
                            @Model.HomeGoals - @Model.AwayGoals
                        </div>
                    }
                    else
                    {
                        <div class="fs-3 fw-bold">
                            VS
                        </div>
                    }

                </div>

                <!-- Visitante -->
                <div class="col-md-5">
                    <img src="@(Model.AwayTeamCrestUrl ?? "/images/crest-placeholder.png")"
                         alt="@Model.AwayTeamName"
                         class="img-fluid mb-3"
                         style="height:110px; width:110px; object-fit:contain;" />

                    <h3 class="fw-bold">
                        @Model.AwayTeamName
                    </h3>
                </div>

            </div>

        </div>
    </div>

    <!-- Cuotas -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4 class="text-center mb-4">
                Cuotas
            </h4>

            <div class="row text-center">

                <div class="col-4">
                    <div class="text-muted">1</div>
                    <div class="fs-4 fw-bold">
                        @Model.HomeOdds.ToString("0.00")
                    </div>
                    <small class="text-muted">
                        @Model.HomeTeamName
                    </small>
                </div>

                <div class="col-4">
                    <div class="text-muted">X</div>
                    <div class="fs-4 fw-bold">
                        @Model.DrawOdds.ToString("0.00")
                    </div>
                    <small class="text-muted">
                        Empate
                    </small>
                </div>

                <div class="col-4">
                    <div class="text-muted">2</div>
                    <div class="fs-4 fw-bold">
                        @Model.AwayOdds.ToString("0.00")
                    </div>
                    <small class="text-muted">
                        @Model.AwayTeamName
                    </small>
                </div>

            </div>

        </div>
    </div>

    <!-- Apuestas -->
    <div class="card shadow-sm mb-4">
        <div class="card-body text-center">

            <h5 class="mb-2">
                Apuestas realizadas
            </h5>

            <div class="display-6 fw-bold">
                @Model.TotalBets
            </div>

            <p class="text-muted mb-0">
                apuestas registradas para este partido
            </p>

        </div>
    </div>

    <!-- Acción: realizar apuesta -->
    @if (Model.Status == MatchStatus.Scheduled &&
         Model.Date > DateTime.UtcNow)
    {
        @if (User.Identity?.IsAuthenticated == true &&
             User.IsInRole(DbSeeder.ApostadorRole))
        {
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4 class="text-center mb-3">
                        ¡Apuesta con tus FutCoins!
                    </h4>

                    <form asp-controller="Bets"
                          asp-action="Place"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="MatchId"
                               value="@Model.Id" />

                        <div class="mb-4">
                            <label for="Amount" class="form-label">
                                Valor de la apuesta
                            </label>

                            <input type="number"
                                   id="Amount"
                                   name="Amount"
                                   class="form-control"
                                   min="1"
                                   max="9999999999"
                                   step="1"
                                   required
                                   placeholder="Ingresa tus FutCoins" />
                        </div>

                        <div class="text-center mb-3">
                            <p class="fw-semibold">
                                Selecciona el resultado:
                            </p>
                        </div>

                        <div class="row g-2 text-center">

                            <!-- Victoria local -->
                            <div class="col-4">
                                <button type="submit"
                                        name="Pick"
                                        value="Home"
                                        class="btn btn-outline-primary w-100">
                                    <strong>1</strong>
                                    <br />
                                    <small>Local</small>
                                    <br />
                                    @Model.HomeOdds.ToString("0.00")
                                </button>
                            </div>

                            <!-- Empate -->
                            <div class="col-4">
                                <button type="submit"
                                        name="Pick"
                                        value="Draw"
                                        class="btn btn-outline-primary w-100">
                                    <strong>X</strong>
                                    <br />
                                    <small>Empate</small>
                                    <br />
                                    @Model.DrawOdds.ToString("0.00")
                                </button>
                            </div>

                            <!-- Victoria visitante -->
                            <div class="col-4">
                                <button type="submit"
                                        name="Pick"
                                        value="Away"
                                        class="btn btn-outline-primary w-100">
                                    <strong>2</strong>
                                    <br />
                                    <small>Visitante</small>
                                    <br />
                                    @Model.AwayOdds.ToString("0.00")
                                </button>
                            </div>

                        </div>

                    </form>

                </div>
            </div>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <div class="text-center mb-4">
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-success">
                    Inicia sesión para apostar
                </a>
            </div>
        }
    }

    <!-- Regresar -->
    <div class="text-center">
        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Volver a la cartelera
        </a>
    </div>

</div>
```