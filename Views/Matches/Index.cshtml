
@using Golbet.Enums
@using Golbet.Services.Helpers
@model IEnumerable<Golbet.DTOs.MatchDto>

@{
    ViewData["Title"] = "Cartelera de Partidos";
    var current = (MatchStatus?)ViewBag.CurrentStatus;
    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    var isAdmin = User.IsInRole("Admin");
    var hasMatches = Model.Any();
}

<style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        background: #f5f5f5;
        color: #222;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .header {
        text-align: center;
        margin-bottom: 30px;
    }

    .header h1 {
        margin-bottom: 8px;
    }

    .header p {
        color: #666;
    }

    .admin-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

    .admin-button {
        display: inline-block;
        padding: 9px 16px;
        border-radius: 5px;
        text-decoration: none;
        font-size: 14px;
        font-weight: bold;
    }

    .admin-button-primary {
        background: #0d6efd;
        color: white;
        border: 1px solid #0d6efd;
    }

    .admin-button-secondary {
        background: white;
        color: #0d6efd;
        border: 1px solid #0d6efd;
    }

    .search-panel {
        background: white;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .search-label {
        display: block;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .search-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .search-input {
        flex: 1;
        min-width: 200px;
        padding: 11px 12px;
        border: 1px solid #bbb;
        border-radius: 5px;
        font-size: 15px;
        box-sizing: border-box;
    }

    .search-button,
    .clear-button {
        display: inline-block;
        padding: 11px 18px;
        border-radius: 5px;
        font-size: 14px;
        font-weight: bold;
        text-decoration: none;
        cursor: pointer;
    }

    .search-button {
        background: #198754;
        color: white;
        border: 1px solid #198754;
    }

    .clear-button {
        background: white;
        color: #555;
        border: 1px solid #bbb;
    }

    .filters {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 30px;
    }

    .filter-button {
        display: inline-block;
        padding: 8px 16px;
        border: 1px solid #198754;
        border-radius: 5px;
        text-decoration: none;
        color: #198754;
        background: white;
        font-size: 14px;
    }

    .filter-button.active {
        background: #198754;
        color: white;
    }

    .matches {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
    }

    .match-card {
        background: white;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    .status {
        text-align: center;
        margin-bottom: 15px;
    }

    .status span {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 15px;
        background: #0d6efd;
        color: white;
        font-size: 13px;
    }

    .date {
        text-align: center;
        color: #666;
        margin-bottom: 20px;
    }

    .teams {
        display: grid;
        grid-template-columns: 1fr 60px 1fr;
        align-items: center;
        text-align: center;
    }

    .team img {
        width: 70px;
        height: 70px;
        object-fit: contain;
        margin-bottom: 8px;
    }

    .team-name {
        font-weight: bold;
    }

    .score {
        font-size: 20px;
        font-weight: bold;
    }

    .vs {
        font-weight: bold;
    }

    .separator {
        border: 0;
        border-top: 1px solid #ddd;
        margin: 20px 0;
    }

    .odds-title {
        text-align: center;
        font-weight: bold;
        margin-bottom: 12px;
    }

    .odds {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        text-align: center;
    }

    .odds-label {
        color: #777;
        font-size: 13px;
    }

    .odds-value {
        font-weight: bold;
        margin-top: 4px;
    }

    .detail-button {
        display: block;
        width: 100%;
        box-sizing: border-box;
        margin-top: 20px;
        padding: 11px 15px;
        background: #198754;
        color: white;
        text-align: center;
        text-decoration: none;
        border-radius: 5px;
        font-weight: bold;
        border: 1px solid #198754;
        cursor: pointer;
    }

    .detail-button:hover {
        background: #146c43;
    }

    .match-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .action-button {
        flex: 1;
        min-width: 90px;
        box-sizing: border-box;
        padding: 9px 10px;
        text-align: center;
        text-decoration: none;
        border-radius: 5px;
        font-size: 13px;
        font-weight: bold;
        cursor: pointer;
    }

    .action-edit {
        background: white;
        color: #0d6efd;
        border: 1px solid #0d6efd;
    }

    .action-delete {
        background: white;
        color: #dc3545;
        border: 1px solid #dc3545;
    }

    .success-message {
        max-width: 800px;
        margin: 0 auto 25px auto;
        padding: 12px 16px;
        background: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
        border-radius: 5px;
        text-align: center;
    }

    .empty-message {
        background: white;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 35px 20px;
        text-align: center;
        color: #555;
    }

    .empty-message h2 {
        margin-top: 0;
        color: #222;
    }
</style>

<div class="container">

    <div class="header">
        <h1>Cartelera de Partidos</h1>
        <p>Partidos y cuotas de GolBet</p>
    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="success-message">
            @TempData["Success"]
        </div>
    }

    @* Opciones de administración: solo para Admin *@

    @if (isAdmin)
    {
        <div class="admin-actions">
            <a asp-controller="Matches"
               asp-action="Create"
               class="admin-button admin-button-primary">
                Nuevo partido
            </a>

            <a asp-controller="Teams"
               asp-action="Index"
               class="admin-button admin-button-secondary">
                Administrar equipos
            </a>
        </div>
    }

    @* Buscador: envía los criterios mediante GET *@

    <div class="search-panel">
        <form asp-controller="Matches"
              asp-action="Index"
              method="get">

            <label for="search" class="search-label">
                Buscar partidos por equipo
            </label>

            <div class="search-row">
                <input type="search"
                       id="search"
                       name="search"
                       value="@currentSearch"
                       class="search-input"
                       placeholder="Ejemplo: Nacional, Medellín..."
                       maxlength="100" />

                @if (current.HasValue)
                {
                    <input type="hidden"
                           name="status"
                           value="@current.Value" />
                }

                <button type="submit" class="search-button">
                    Buscar
                </button>

                <a asp-controller="Matches"
                   asp-action="Index"
                   class="clear-button">
                    Limpiar
                </a>
            </div>
        </form>
    </div>

    @* Filtros de partidos: conservan la búsqueda actual *@

    <div class="filters">

        <a asp-controller="Matches"
           asp-action="Index"
           asp-route-search="@currentSearch"
           class="filter-button @(current is null ? "active" : "")">
            Todos
        </a>

        <a asp-controller="Matches"
           asp-action="Index"
           asp-route-status="@MatchStatus.Scheduled"
           asp-route-search="@currentSearch"
           class="filter-button @(current == MatchStatus.Scheduled ? "active" : "")">
            Programados
        </a>

        <a asp-controller="Matches"
           asp-action="Index"
           asp-route-status="@MatchStatus.InProgress"
           asp-route-search="@currentSearch"
           class="filter-button @(current == MatchStatus.InProgress ? "active" : "")">
            En juego
        </a>

        <a asp-controller="Matches"
           asp-action="Index"
           asp-route-status="@MatchStatus.Finished"
           asp-route-search="@currentSearch"
           class="filter-button @(current == MatchStatus.Finished ? "active" : "")">
            Finalizados
        </a>

    </div>

    @* Resultados de la búsqueda *@

    @if (hasMatches)
    {
        <div class="matches">

            @foreach (var match in Model)
            {
                var statusText = match.Status switch
                {
                    MatchStatus.Scheduled => "Programado",
                    MatchStatus.InProgress => "En juego",
                    MatchStatus.Finished => "Finalizado",
                    _ => match.Status.ToString()
                };

                <div class="match-card">

                    <div class="status">
                        <span>@statusText</span>
                    </div>

                    <div class="date">
                        @match.Date.ToColombiaTime().ToString("dd/MM/yyyy HH:mm")
                    </div>

                    <div class="teams">

                        <div class="team">
                            <img src="@(match.HomeTeamCrestUrl ?? "/images/crest-placeholder.png")"
                                 alt="Escudo de @match.HomeTeamName" />

                            <div class="team-name">
                                @match.HomeTeamName
                            </div>
                        </div>

                        <div>
                            @if (match.Status == MatchStatus.Finished)
                            {
                                <div class="score">
                                    @match.HomeGoals - @match.AwayGoals
                                </div>
                            }
                            else
                            {
                                <div class="vs">VS</div>
                            }
                        </div>

                        <div class="team">
                            <img src="@(match.AwayTeamCrestUrl ?? "/images/crest-placeholder.png")"
                                 alt="Escudo de @match.AwayTeamName" />

                            <div class="team-name">
                                @match.AwayTeamName
                            </div>
                        </div>

                    </div>

                    <hr class="separator" />

                    <div class="odds-title">Cuotas</div>

                    <div class="odds">
                        <div>
                            <div class="odds-label">1</div>
                            <div class="odds-value">
                                @match.HomeOdds.ToString("0.00")
                            </div>
                        </div>

                        <div>
                            <div class="odds-label">X</div>
                            <div class="odds-value">
                                @match.DrawOdds.ToString("0.00")
                            </div>
                        </div>

                        <div>
                            <div class="odds-label">2</div>
                            <div class="odds-value">
                                @match.AwayOdds.ToString("0.00")
                            </div>
                        </div>
                    </div>

                    <a asp-controller="Matches"
                       asp-action="Detail"
                       asp-route-id="@match.Id"
                       class="detail-button">
                        Ver detalle
                    </a>

                    @* Editar y desactivar: solo para Admin *@

                    @if (isAdmin)
                    {
                        <div class="match-actions">

                            <a asp-controller="Matches"
                               asp-action="Edit"
                               asp-route-id="@match.Id"
                               class="action-button action-edit">
                                Editar
                            </a>

                            <form asp-controller="Matches"
                                  asp-action="Deactivate"
                                  method="post"
                                  style="flex:1;">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@match.Id" />

                                <button type="submit"
                                        class="action-button action-delete"
                                        style="width:100%;"
                                        onclick="return confirm('¿Está seguro de desactivar este partido?');">
                                    Desactivar
                                </button>

                            </form>

                        </div>
                    }

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-message">
            @if (!string.IsNullOrWhiteSpace(currentSearch))
            {
                <h2>No se encontraron partidos</h2>
                <p>
                    No hay partidos cuyos equipos coincidan con
                    <strong>@currentSearch</strong>
                    @if (current.HasValue)
                    {
                        <span>con el estado seleccionado.</span>
                    }
                    else
                    {
                        <span>.</span>
                    }
                </p>
            }
            else
            {
                <h2>No hay partidos disponibles</h2>
                <p>No existen partidos para el filtro seleccionado.</p>
            }

            <a asp-controller="Matches"
               asp-action="Index"
               class="detail-button">
                Volver a la cartelera  de partidos
            </a>
        </div>
    }

</div>

