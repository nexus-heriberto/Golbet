@using Golbet.Enums
@using Golbet.Helpers
@model IEnumerable<Golbet.DTOs.MatchDto>

@{
    ViewData["Title"] = "Cartelera de Partidos";
}

<div class="container py-4">
    <div class="text-center mb-4">
        <h1 class="display-5">Cartelera de Partidos</h1>
        <p class="text-muted">Partidos y cuotas de GolBet</p>
    </div>

    <div class="row g-4">
        @foreach (var match in Model)
        {
            var statusText = match.Status switch
            {
                MatchStatus.Scheduled => "Programado",
                MatchStatus.InProgress => "En juego",
                MatchStatus.Finished => "Finalizado",
                
                _ => match.Status.ToString()
            };

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">

                        <div class="text-center mb-3">
                            <span class="badge bg-primary">
                                @statusText
                            </span>
                        </div>

                        <div class="text-center text-muted mb-3">
                            @match.Date.ToColombiaTime().ToString("dd/MM/yyyy HH:mm")
                        </div>

                        <div class="row align-items-center text-center">

                            <div class="col-5">
                                <img src="@(match.HomeTeamCrestUrl ?? "/images/crest-placeholder.png")"
                                     alt="@match.HomeTeamName"
                                     class="img-fluid mb-2"
                                     style="height:70px; width:70px; object-fit:contain;" />

                                <div class="fw-bold">
                                    @match.HomeTeamName
                                </div>
                            </div>

                            <div class="col-2">
                                @if (match.Status == MatchStatus.Finished)
                                {
                                    <div class="fs-4 fw-bold">
                                        @match.HomeGoals - @match.AwayGoals
                                    </div>
                                }
                                else
                                {
                                    <div class="fw-bold">
                                        VS
                                    </div>
                                }
                            </div>

                            <div class="col-5">
                                <img src="@(match.AwayTeamCrestUrl ?? "/images/crest-placeholder.png")"
                                     alt="@match.AwayTeamName"
                                     class="img-fluid mb-2"
                                     style="height:70px; width:70px; object-fit:contain;" />

                                <div class="fw-bold">
                                    @match.AwayTeamName
                                </div>
                            </div>

                        </div>

                        <hr />

                        <div class="text-center">
                            <h6 class="mb-3">Cuotas</h6>

                            <div class="row">
                                <div class="col-4">
                                    <small class="text-muted">1</small>
                                    <div class="fw-bold">
                                        @match.HomeOdds.ToString("0.00")
                                    </div>
                                </div>

                                <div class="col-4">
                                    <small class="text-muted">X</small>
                                    <div class="fw-bold">
                                        @match.DrawOdds.ToString("0.00")
                                    </div>
                                </div>

                                <div class="col-4">
                                    <small class="text-muted">2</small>
                                    <div class="fw-bold">
                                        @match.AwayOdds.ToString("0.00")
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>