```cshtml
@using Golbet.Enums
@using Golbet.Helpers
@model IEnumerable<Golbet.DTOs.MatchDto>

@{
    ViewData["Title"] = "Cartelera de Partidos";
    var current = (MatchStatus?)ViewBag.CurrentStatus;
}

<style>
    body {
        font-family: Arial, sans-serif;
        margin: 0;
        background: #f5f5f5;
        color: #222;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .header {
        text-align: center;
        margin-bottom: 30px;
    }

        .header h1 {
            margin-bottom: 8px;
        }

        .header p {
            color: #666;
        }

    .filters {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 30px;
    }

    .filter-button {
        display: inline-block;
        padding: 8px 16px;
        border: 1px solid #198754;
        border-radius: 5px;
        text-decoration: none;
        color: #198754;
        background: white;
        font-size: 14px;
    }

        .filter-button.active {
            background: #198754;
            color: white;
        }

    .matches {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
    }

    .match-card {
        background: white;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    .status {
        text-align: center;
        margin-bottom: 15px;
    }

        .status span {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 15px;
            background: #0d6efd;
            color: white;
            font-size: 13px;
        }

    .date {
        text-align: center;
        color: #666;
        margin-bottom: 20px;
    }

    .teams {
        display: grid;
        grid-template-columns: 1fr 60px 1fr;
        align-items: center;
        text-align: center;
    }

    .team img {
        width: 70px;
        height: 70px;
        object-fit: contain;
        margin-bottom: 8px;
    }

    .team-name {
        font-weight: bold;
    }

    .score {
        font-size: 20px;
        font-weight: bold;
    }

    .vs {
        font-weight: bold;
    }

    .separator {
        border: 0;
        border-top: 1px solid #ddd;
        margin: 20px 0;
    }

    .odds-title {
        text-align: center;
        font-weight: bold;
        margin-bottom: 12px;
    }

    .odds {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        text-align: center;
    }

    .odds-label {
        color: #777;
        font-size: 13px;
    }

    .odds-value {
        font-weight: bold;
        margin-top: 4px;
    }

    .detail-button {
        display: block;
        width: 100%;
        box-sizing: border-box;
        margin-top: 20px;
        padding: 11px 15px;
        background: #198754;
        color: white;
        text-align: center;
        text-decoration: none;
        border-radius: 5px;
        font-weight: bold;
        border: 1px solid #198754;
        cursor: pointer;
    }

        .detail-button:hover {
            background: #146c43;
        }
</style>

<div class="container">

    <div class="header">
        <h1>Cartelera de Partidos</h1>
        <p>Partidos y cuotas de GolBet</p>
    </div>

    <!-- Filtros -->
    <div class="filters">

        <a asp-action="Index"
           class="filter-button @(current is null ? "active" : "")">
            Todos
        </a>

        <a asp-action="Index"
           asp-route-status="@MatchStatus.Scheduled"
           class="filter-button @(current == MatchStatus.Scheduled ? "active" : "")">
            Programados
        </a>

        <a asp-action="Index"
           asp-route-status="@MatchStatus.InProgress"
           class="filter-button @(current == MatchStatus.InProgress ? "active" : "")">
            En juego
        </a>

        <a asp-action="Index"
           asp-route-status="@MatchStatus.Finished"
           class="filter-button @(current == MatchStatus.Finished ? "active" : "")">
            Finalizados
        </a>

    </div>

    <!-- Partidos -->
    <div class="matches">

        @foreach (var match in Model)
        {
            var statusText = match.Status switch
            {
                MatchStatus.Scheduled => "Programado",
                MatchStatus.InProgress => "En juego",
                MatchStatus.Finished => "Finalizado",
                _ => match.Status.ToString()
            };

            <div class="match-card">

                <!-- Estado -->
                <div class="status">
                    <span>
                        @statusText
                    </span>
                </div>

                <!-- Fecha -->
                <div class="date">
                    @match.Date.ToColombiaTime().ToString("dd/MM/yyyy HH:mm")
                </div>

                <!-- Equipos -->
                <div class="teams">

                    <div class="team">

                        <img src="@(match.HomeTeamCrestUrl ?? "/images/crest-placeholder.png")"
                             alt="@match.HomeTeamName" />

                        <div class="team-name">
                            @match.HomeTeamName
                        </div>

                    </div>

                    <div>

                        @if (match.Status == MatchStatus.Finished)
                        {
                            <div class="score">
                                @match.HomeGoals - @match.AwayGoals
                            </div>
                        }
                        else
                        {
                            <div class="vs">
                                VS
                            </div>
                        }

                    </div>

                    <div class="team">

                        <img src="@(match.AwayTeamCrestUrl ?? "/images/crest-placeholder.png")"
                             alt="@match.AwayTeamName" />

                        <div class="team-name">
                            @match.AwayTeamName
                        </div>

                    </div>

                </div>

                <hr class="separator" />

                <!-- Cuotas -->
                <div class="odds-title">
                    Cuotas
                </div>

                <div class="odds">

                    <div>
                        <div class="odds-label">1</div>
                        <div class="odds-value">
                            @match.HomeOdds.ToString("0.00")
                        </div>
                    </div>

                    <div>
                        <div class="odds-label">X</div>
                        <div class="odds-value">
                            @match.DrawOdds.ToString("0.00")
                        </div>
                    </div>

                    <div>
                        <div class="odds-label">2</div>
                        <div class="odds-value">
                            @match.AwayOdds.ToString("0.00")
                        </div>
                    </div>

                </div>

                <!-- Ver detalle -->
                <a asp-action="Detail"
                   asp-route-id="@match.Id"
                   class="detail-button">
                    Ver detalle
                </a>

            </div>
        }

    </div>

</div>
```
