@model Golbet.DTOs.MatchFormDto

@{
    ViewData["Title"] = "Editar partido";
    var teams = ViewBag.Teams as IEnumerable<Golbet.DTOs.TeamDto>
                 ?? Enumerable.Empty<Golbet.DTOs.TeamDto>();
}

<div class="container mt-4">

    <div class="mb-4">
        <h1>Editar partido</h1>
        <p class="text-muted">
            Modifique la información del partido.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="HomeTeamId"
                           class="form-label">
                    </label>

                    <select asp-for="HomeTeamId"
                            class="form-select">

                        <option value="0">
                            -- Seleccione el equipo local --
                        </option>

                        @foreach (var team in teams)
                        {
                            <option value="@team.Id">
                                @team.Name
                            </option>
                        }

                    </select>

                    <span asp-validation-for="HomeTeamId"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="AwayTeamId"
                           class="form-label">
                    </label>

                    <select asp-for="AwayTeamId"
                            class="form-select">

                        <option value="0">
                            -- Seleccione el equipo visitante --
                        </option>

                        @foreach (var team in teams)
                        {
                            <option value="@team.Id">
                                @team.Name
                            </option>
                        }

                    </select>

                    <span asp-validation-for="AwayTeamId"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Date"
                           class="form-label">
                    </label>

                    <input asp-for="Date"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="Date"
                          class="text-danger">
                    </span>
                </div>

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label asp-for="HomeOdds"
                               class="form-label">
                        </label>

                        <input asp-for="HomeOdds"
                               class="form-control"
                               type="number"
                               step="0.01" />

                        <span asp-validation-for="HomeOdds"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="DrawOdds"
                               class="form-label">
                        </label>

                        <input asp-for="DrawOdds"
                               class="form-control"
                               type="number"
                               step="0.01" />

                        <span asp-validation-for="DrawOdds"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="AwayOdds"
                               class="form-label">
                        </label>

                        <input asp-for="AwayOdds"
                               class="form-control"
                               type="number"
                               step="0.01" />

                        <span asp-validation-for="AwayOdds"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar cambios
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
